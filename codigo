# ==========================================
# MOTOR MATEMÁTICO: CÁLCULO DE RESIDUOS Y CAUCHY
# ==========================================
def calcular_residuos_y_cauchy(polos, radio_curva, cx_val, cy_val, caso_seleccionado):
    residuos_atrapados = []
    integral_cauchy = complex(0, 0)
    s, z = sp.symbols('s z')

    if "Caso 1" in caso_seleccionado:
        var_compleja = z
        H = (z**2) / ((z - 0.5) * (z - 0.85))
    elif "Caso 2" in caso_seleccionado:
        var_compleja = s
        H = (s + 2) / (s**2 + 4*s + 13)
    else:
        var_compleja = s
        H = 1 / (((s - 1)**2) * (s + 3))

    polos_unicos = set(polos)
    centro_complejo = complex(cx_val, cy_val)

    for p in polos_unicos:
        if np.abs(p - centro_complejo) < radio_curva:
            multiplicidad = polos.count(p)
            p_simbolico = sp.simplify(p)

            if multiplicidad == 1:
                factor = (var_compleja - p_simbolico) * H
                residuo_analitico = sp.limit(factor, var_compleja, p_simbolico)
            else:
                m = multiplicidad
                factor = ((var_compleja - p_simbolico)**m) * H
                derivada = sp.diff(factor, var_compleja, m - 1)
                residuo_analitico = sp.limit(derivada, var_compleja, p_simbolico) / sp.factorial(m - 1)

            res_val = complex(sp.N(residuo_analitico))
            residuos_atrapados.append((p, res_val, multiplicidad))

    if residuos_atrapados:
        suma_residuos = sum([res[1] for res in residuos_atrapados])
        integral_cauchy = 2 * np.pi * 1j * suma_residuos

    return residuos_atrapados, integral_cauchy

